# Production environment for the single-VPS deployment.
#
#   cp deploy/env.prod.example .env
#   # fill every value, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Generate the secrets with:
#   openssl rand -base64 32          # each password / master key
#   docker compose run --rm gateway php artisan key:generate --show   # APP_KEY
#
# .env is gitignored. Never commit a filled copy.

# --- Domains -----------------------------------------------------------------
# The domain bought for the project. Caddy issues certificates for
# api.$ROOT_DOMAIN, media.$ROOT_DOMAIN and storefront.$ROOT_DOMAIN, so all three
# must have A records pointing at the VPS before the first start.
ROOT_DOMAIN=lavillasb.com

# Where the storefront is actually served from. On the $11 plan this is the
# Vercel deployment on the apex; it is the only origin the API accepts calls
# from, and the domain Sanctum treats as first-party.
STOREFRONT_ORIGIN=https://lavillasb.com
STOREFRONT_DOMAIN=lavillasb.com

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# --- Secrets -----------------------------------------------------------------
DB_PASSWORD=
RABBITMQ_DEFAULT_PASS=
MEILI_MASTER_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_KEY=

# First admin account, created on boot. Change the password after first login.
ADMIN_EMAIL=admin@lavillasb.com
ADMIN_PASSWORD=

# --- Optional ----------------------------------------------------------------
# Natural-language product search falls back to keyword matching without it.
OPENAI_API_KEY=
